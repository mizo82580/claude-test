# =====================================================================
#  اعمل نسخة من الملف ده باسم  .env  وعدّل القيم اللي محتاجها
#  (start.bat بيعملها لوحده أول مرة)
# =====================================================================

# paper = محاكاة بأسعار حقيقية من غير فلوس  |  live = تداول حقيقي
MODE=paper

# المفتاح الخاص لمحفظة البوت (Phantom > Settings > Manage Accounts > Show Private Key)
# استخدم محفظة جديدة مخصوصة للبوت فيها المبلغ اللي هتتداول بيه بس
# متبعتش المفتاح ده لأي حد ومتنشرش ملف .env أبداً
PRIVATE_KEY=

# RPC: العام بطيء ومحدود. خد مفتاح مجاني من helius.dev وحط اللينك هنا
# مثال: https://mainnet.helius-rpc.com/?api-key=XXXX
RPC_URL=https://api.mainnet-beta.solana.com

# مفتاح Jupiter مجاني من https://portal.jup.ag  (من غيره البوت بيستخدم lite-api المجاني الأبطأ)
JUP_API_KEY=

# ---------------- إدارة الفلوس ----------------
# حجم كل صفقة بالـ SOL (0.1 = حوالي 10% من 1 SOL)
TRADE_SIZE_SOL=0.1
# أقصى عدد صفقات مفتوحة في نفس الوقت
MAX_OPEN_POSITIONS=2
# رصيد بيفضل في المحفظة دايماً للرسوم وإيجار حسابات التوكن
MIN_SOL_RESERVE=0.05
# لو خسارة اليوم وصلت للرقم ده البوت بيبطل يشتري لحد بكرة (بتوقيت UTC)
MAX_DAILY_LOSS_SOL=0.3
MAX_TRADES_PER_DAY=40
# تقدير رسوم الشبكة لكل عملية (شراء أو بيع) بيتحسب في الربح والخسارة
FEE_ESTIMATE_SOL=0.0003
# رصيد المحاكاة في وضع paper
PAPER_START_BALANCE_SOL=1

# ---------------- شروط الدخول ----------------
# أقل سيولة بالدولار
MIN_LIQUIDITY_USD=15000
# 0 = من غير حد أقصى
MAX_LIQUIDITY_USD=0
# عمر العملة بالدقايق: بنتجنب أول دقيقتين (ملعب بوتات القنص والـ rugs السريعة)
MIN_AGE_MIN=2
MAX_AGE_MIN=60
MIN_MCAP_USD=0
MAX_MCAP_USD=1500000
# تغير السعر آخر 5 دقايق: لازم يكون طالع، بس مش طار خلاص
MIN_M5_CHANGE_PCT=3
MAX_M5_CHANGE_PCT=40
# عدد عمليات الشراء آخر 5 دقايق
MIN_M5_BUYS=25
# نسبة الشراء للبيع آخر 5 دقايق
MIN_BUY_SELL_RATIO=1.3
# حجم التداول بالدولار آخر 5 دقايق
MIN_M5_VOLUME_USD=5000
# فاضي = كل المنصات. مثال: pumpswap,raydium,meteora
ALLOWED_DEXES=
# اختبار شراء وبيع وهمي قبل الدخول: لو هتخسر أكتر من كده في اللفة، يبقى السيولة ضعيفة أو فيه ضريبة أو honeypot
MAX_ROUNDTRIP_LOSS_PCT=6

# ---------------- فحص الأمان ----------------
REQUIRE_NO_MINT_AUTHORITY=true
REQUIRE_NO_FREEZE_AUTHORITY=true
USE_JUP_SHIELD=true
USE_RUGCHECK=true
# true = متشتريش لو RugCheck مش متاح
RUGCHECK_REQUIRED=false

# ---------------- شروط الخروج ----------------
# بيع عند ربح X% (صافي بعد الرسوم التقديرية)
TAKE_PROFIT_PCT=10
# بيع عند خسارة X%
STOP_LOSS_PCT=8
# Trailing: لو الربح وصل 6% وبعدين نزل 4% من أعلى نقطة، بيع (0 = إيقاف)
TRAIL_ACTIVATE_PCT=6
TRAIL_DISTANCE_PCT=4
# أقصى مدة للصفقة بالثواني، بعدها بيبيع بأي سعر
MAX_HOLD_SEC=120
# كل كام ملي ثانية يشيك على سعر الصفقات المفتوحة
PRICE_CHECK_MS=1500
# لو مفيش سعر بيع كذا مرة ورا بعض (غالباً rug) يحاول يبيع فوراً
MAX_QUOTE_FAILS=6
# يقفل حساب التوكن بعد البيع ويرجعلك حوالي 0.002 SOL
CLOSE_TOKEN_ACCOUNTS=true

# ---------------- البحث عن العملات ----------------
SCAN_INTERVAL_SEC=5
DISCOVERY_INTERVAL_SEC=30
GECKO_NEW_POOL_PAGES=2
USE_GECKO_TRENDING=true
USE_DEXSCREENER_PROFILES=true
MAX_WATCHLIST=150
MAX_CANDIDATES_PER_SCAN=3
RECHECK_AFTER_SEC=60
# بعد ما يبيع عملة مايرجعش يشتريها تاني قبل X دقيقة
COOLDOWN_MIN=60

# ---------------- متقدم ----------------
# المسافة بين طلبات Jupiter (مع مفتاح مدفوع ممكن تقللها)
JUP_MIN_INTERVAL_MS=1100
# فاضي أو 0 = Jupiter يحدد الـ slippage تلقائياً (الأفضل)
SLIPPAGE_BPS=
# فاضي = تلقائي. لو Jupiter غيّر العنوان: https://api.jup.ag/swap/v2
JUP_SWAP_BASE=
# debug لتفاصيل أكتر
LOG_LEVEL=info
